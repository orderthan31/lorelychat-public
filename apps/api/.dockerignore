# Explicit production build inputs; all other root files are excluded.
*
!requirements.txt
!pyproject.toml
!docker-entrypoint.sh
!app/
!app/**
!scripts/
!scripts/**
!seeds/
!seeds/**
# Re-included source trees must not admit nested operating state or caches.
**/__pycache__
**/__pycache__/**
**/.pytest_cache
**/.venv
**/.env
**/.env.*
**/.runtime
**/.runtime/**
**/*.pyc
**/*.db
**/*.db-*
**/*.sqlite
**/*.sqlite-*
**/*.log
**/provider_secrets.json
**/secrets
**/secrets/**
**/data
**/uploads
**/logs
**/node_modules
**/reports
**/test-results

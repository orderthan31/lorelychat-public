# Docker Compose project
COMPOSE_PROJECT_NAME=lorechat
LORECHAT_BIND_ADDRESS=127.0.0.1
LORECHAT_PORT=8080

# Safe default: runs deterministic mock replies without a paid provider key.
LLM_MOCK=true
LORECHAT_SEED_DEMO=true
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Optional legacy OpenAI-compatible endpoint. Prefer configuring providers in the UI.
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=
LLM_API_KEY=

# Optional provider-specific values. Leave blank unless used.
CHAT_LLM_PROVIDER=openai_compatible
CHAT_LLM_BASE_URL=
CHAT_LLM_MODEL=
CHAT_LLM_API_KEY=
GEMINI_API_KEY=

# Optional external semantic memory (disabled by default).
MEMORY_PROVIDER=local
MEM0_ENABLED=false
MEM0_API_KEY=
MEM0_BASE_URL=
